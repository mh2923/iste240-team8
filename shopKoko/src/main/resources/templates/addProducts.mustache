<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Add Product</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #0f172a, #1e293b);
            color: #f8fafc;
        }

        .container {
            width: 92%;
            max-width: 700px;
            margin: 40px auto;
            padding: 20px;
        }

        .card {
            background: #111827;
            padding: 28px;
            border-radius: 18px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.25);
        }

        h1 {
            text-align: center;
            margin-top: 0;
            margin-bottom: 10px;
        }

        .subtitle {
            text-align: center;
            color: #cbd5e1;
            margin-bottom: 25px;
        }

        form {
            display: grid;
            gap: 16px;
        }

        label {
            display: block;
            margin-bottom: 6px;
            font-weight: bold;
            color: #dbeafe;
        }

        input, select {
            width: 100%;
            padding: 12px;
            border-radius: 10px;
            border: 1px solid #334155;
            background: #0f172a;
            color: white;
            font-size: 1rem;
        }

        input:focus, select:focus {
            outline: none;
            border-color: #fffb08;
            box-shadow: 0 0 0 3px rgba(96,165,250,0.20);
        }

        .actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            justify-content: center;
            margin-top: 10px;
        }

        .btn {
            display: inline-block;
            padding: 12px 18px;
            border-radius: 10px;
            text-decoration: none;
            font-weight: bold;
            border: none;
            cursor: pointer;
            font-size: 1rem;
        }

        .submit-btn {
            background: #FFF34DB5;
            color: #1e293b;
        }

        .submit-btn:hover {
            background: #918a15;
        }

        .secondary-btn {
            background: transparent;
            border: 2px solid #FBF89BFF;
            color: #FBF89BFF;
        }

        .secondary-btn:hover {
            background: #FBF89BFF;
            color: #0f172a;
        }
    </style>
</head>
<body>
<div class="container">
    <div class="card">
        <h1>Add Product</h1>
        <p class="subtitle">Enter the new product details below.</p>

        <form method="post" action="/products/add">
            <div>
                <label for="productName">Product Name</label>
                <input type="text" id="productName" name="productName" required>
            </div>

            <div>
                <label for="productDescription">Description</label>
                <input type="text" id="productDescription" name="productDescription" required>
            </div>

            <div>
                <label for="productPrice">Price</label>
                <input type="number" step="0.01" id="productPrice" name="productPrice" required>
            </div>

            <div>
                <label for="productQuantity">Quantity</label>
                <input type="number" id="productQuantity" name="productQuantity" required>
            </div>

            <div>
                <label for="productCost">Cost</label>
                <input type="number" step="0.01" id="productCost" name="productCost" required>
            </div>

            <div>
                <label for="productAvailable">Available</label>
                <select id="productAvailable" name="productAvailable">
                    <option value="true">Yes</option>
                    <option value="false">No</option>
                </select>
            </div>

            <div class="actions">
                <button type="submit" class="btn submit-btn">Submit Product</button>
                <a href="/products" class="btn secondary-btn">View Products</a>
                <a href="/" class="btn secondary-btn">Home</a>
            </div>
        </form>
    </div>
</div>
</body>
</html>