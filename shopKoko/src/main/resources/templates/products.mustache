<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Product List</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #0f172a;
            color: #f8fafc;
        }

        .container {
            width: 92%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 35px 20px 50px;
        }

        .top {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 25px;
        }

        h1 {
            margin: 0;
            color: #ffffff;
        }

        .nav-buttons a {
            display: inline-block;
            margin-left: 10px;
            padding: 10px 16px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: bold;
        }

        .home-btn {
            background: transparent;
            border: 2px solid #FBF89BFF;
            color: #FBF89BFF;
        }

        .home-btn:hover {
            background: #FBF89BFF;
            color: #0f172a;
        }

        .add-btn {
            background: #FFF34DB5;
            color: #1e293b;
        }

        .add-btn:hover {
            background: #918a15;
        }

        .table-wrapper {
            background: #111827;
            border-radius: 16px;
            padding: 20px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.25);
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 850px;
        }

        thead {
            background: #918a15;
        }

        th, td {
            padding: 14px 16px;
            text-align: left;
            border-bottom: 1px solid #334155;
        }

        th {
            color: #ffffff;
        }

        tbody tr:hover {
            background: rgba(59,130,246,0.10);
        }

        .badge {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 999px;
            font-size: 0.9rem;
            font-weight: bold;
        }

        .available {
            background: rgba(34,197,94,0.18);
            color: #86efac;
        }

        .unavailable {
            background: rgba(239,68,68,0.18);
            color: #fca5a5;
        }

        .empty-message {
            margin-top: 20px;
            color: #cbd5e1;
        }
    </style>
</head>
<body>
<div class="container">
    <div class="top">
        <h1>Product List</h1>
        <div class="nav-buttons">
            <a href="/" class="home-btn">Home</a>
            <a href="/products/add" class="add-btn">Add Product</a>
        </div>
    </div>

    <div class="table-wrapper">
        <table>
            <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Price (AED)</th>
                <th>Quantity</th>
                <th>Cost (AED)</th>
                <th>Available</th>
            </tr>
            </thead>
            <tbody id="productTable">
            {{#productList}}
                <tr>
                    <td>{{productName}}</td>
                    <td>{{productDescription}}</td>
                    <td>{{productPrice}}</td>
                    <td>{{productQuantity}}</td>
                    <td>{{productCost}}</td>
                    <td>
                        {{#productAvailable}}
                            <span class="badge available">Yes</span>
                        {{/productAvailable}}
                        {{^productAvailable}}
                            <span class="badge unavailable">No</span>
                        {{/productAvailable}}
                    </td>
                </tr>
            {{/productList}}
            </tbody>
        </table>
    </div>

    <p class="empty-message">Use the Add Product page to submit a new product record.</p>
</div>
</body>
</html>